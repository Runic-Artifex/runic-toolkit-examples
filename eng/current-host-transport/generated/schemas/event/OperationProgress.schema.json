{
  "$defs": {
    "Int": {
      "description": "an integer",
      "title": "int",
      "type": "integer"
    },
    "Uuid": {
      "description": "a string matching the pattern ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "runic.artifex.setup/1/OperationProgress",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "_tag": {
      "enum": [
        "OperationProgress"
      ],
      "type": "string"
    },
    "completed": {
      "$ref": "#/$defs/Int",
      "description": "a non-negative number",
      "minimum": 0,
      "title": "nonNegative"
    },
    "message": {
      "type": "string"
    },
    "operationId": {
      "$ref": "#/$defs/Uuid"
    },
    "total": {
      "$ref": "#/$defs/Int",
      "description": "a positive number",
      "exclusiveMinimum": 0,
      "title": "positive"
    }
  },
  "required": [
    "_tag",
    "operationId",
    "completed",
    "total"
  ],
  "type": "object"
}
