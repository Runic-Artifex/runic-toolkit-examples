<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RunicArtifex.Examples.Assets</RootNamespace>
    <AssemblyName>RunicAssets.Canary</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RunicAssets" />
    <PackageReference Include="RunicAssets.CsWebUi" />
    <PackageReference Include="RunicAssets.AspNetCore" />
    <PackageReference Include="RunicAssets.RunicToolkit" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="index.html" LogicalName="RunicAssets.Canary.index.html" />
    <EmbeddedResource Include="assets/app.css" LogicalName="RunicAssets.Canary.assets.app.css" />
  </ItemGroup>
</Project>
