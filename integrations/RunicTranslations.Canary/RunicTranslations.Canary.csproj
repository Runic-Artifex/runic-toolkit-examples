<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RunicArtifex.Examples.Translations</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RunicTranslations" />
    <PackageReference Include="RunicTranslations.Build" PrivateAssets="all" />
    <PackageReference Include="RunicTranslations.Generator"
                      PrivateAssets="all"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <TextResourceCatalog Include="Resources/catalog.json" />
    <TextResourceDocument Include="Resources/en.json" />
  </ItemGroup>
</Project>
