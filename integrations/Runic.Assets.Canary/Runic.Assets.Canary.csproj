<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RunicArtifex.Examples.Assets</RootNamespace>
    <AssemblyName>Runic.Assets.Canary</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Runic.Assets" />
    <PackageReference Include="Runic.Assets.AspNetCore" />
    <PackageReference Include="Runic.Assets.Desktop" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="index.html" LogicalName="Runic.Assets.Canary.index.html" />
    <EmbeddedResource Include="assets/app.css" LogicalName="Runic.Assets.Canary.assets.app.css" />
  </ItemGroup>
</Project>
