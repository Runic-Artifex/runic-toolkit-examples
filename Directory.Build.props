<Project>
  <PropertyGroup>
    <!--
      Development is the approachable inner loop. Verification is selected by CI
      and eng/verify.ps1 for locked restores and release-grade analysis.
    -->
    <WebUIToolkitBuildMode Condition="'$(WebUIToolkitBuildMode)' == '' and '$(CI)' == 'true'">Verification</WebUIToolkitBuildMode>
    <WebUIToolkitBuildMode Condition="'$(WebUIToolkitBuildMode)' == ''">Development</WebUIToolkitBuildMode>
    <WebUIToolkitVerificationBuild Condition="'$(WebUIToolkitBuildMode)' == 'Verification'">true</WebUIToolkitVerificationBuild>
    <WebUIToolkitVerificationBuild Condition="'$(WebUIToolkitVerificationBuild)' == ''">false</WebUIToolkitVerificationBuild>

    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(WebUIToolkitVerificationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>
    <Authors>RunicArtifex</Authors>
    <Company>RunicArtifex</Company>
    <Copyright>Copyright (c) 2026 Viktor Jannicke</Copyright>
    <RepositoryUrl>https://github.com/Runic-Artifex/runic-toolkit-examples</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Runic-Artifex/runic-toolkit-examples</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NuGetAudit Condition="'$(WebUIToolkitVerificationBuild)' == 'true'">true</NuGetAudit>
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">false</NuGetAudit>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <WebUIToolkitDefaultTargetFramework>net10.0</WebUIToolkitDefaultTargetFramework>
    <WebUIToolkitCompatibilityTargetFramework>net10.0</WebUIToolkitCompatibilityTargetFramework>
    <WebUIToolkitGeneratorTargetFramework>net10.0</WebUIToolkitGeneratorTargetFramework>
  </PropertyGroup>
</Project>
