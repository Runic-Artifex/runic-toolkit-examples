<Project>
  <PropertyGroup>
    <!--
      Development is the approachable inner loop. Verification is selected by CI
      and eng/verify.ps1 for locked restores and release-grade analysis.
    -->
    <WebUIToolkitBuildMode Condition="'$(WebUIToolkitBuildMode)' == '' and '$(CI)' == 'true'">Verification</WebUIToolkitBuildMode>
    <WebUIToolkitBuildMode Condition="'$(WebUIToolkitBuildMode)' == ''">Development</WebUIToolkitBuildMode>
    <WebUIToolkitVerificationBuild Condition="'$(WebUIToolkitBuildMode)' == 'Verification'">true</WebUIToolkitVerificationBuild>
    <WebUIToolkitVerificationBuild Condition="'$(WebUIToolkitVerificationBuild)' == ''">false</WebUIToolkitVerificationBuild>

    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(WebUIToolkitVerificationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ViktorJannicke/WebUIToolkit</RepositoryUrl>
    <!-- Repository projects keep updateable lock files; only Verification locks them. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(WebUIToolkitVerificationBuild)' == 'true'">true</RestoreLockedMode>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">false</RestoreLockedMode>
    <NuGetAudit Condition="'$(WebUIToolkitVerificationBuild)' == 'true'">true</NuGetAudit>
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">false</NuGetAudit>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <WebUIToolkitDefaultTargetFramework>net10.0</WebUIToolkitDefaultTargetFramework>
    <WebUIToolkitCompatibilityTargetFramework>net8.0</WebUIToolkitCompatibilityTargetFramework>
    <WebUIToolkitGeneratorTargetFramework>netstandard2.0</WebUIToolkitGeneratorTargetFramework>
  </PropertyGroup>
</Project>
