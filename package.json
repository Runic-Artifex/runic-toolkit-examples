{
  "name": "@runic-artifex/toolkit-examples",
  "private": true,
  "version": "0.0.0-private",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "workspaces": [
    "samples/03-SetupApplication/Frontend",
    "samples/04-SvelteKitSetupApplication/Frontend"
  ],
  "scripts": {
    "generate:setup-contract": "node eng/generate-setup-contract.mjs",
    "verify:setup-contract": "node eng/generate-setup-contract.mjs --check",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run verify:setup-contract && npm run typecheck && npm run test && npm run build && npm run verify:production --workspaces --if-present"
  },
  "devDependencies": {
    "@runic-artifex/vite-plugin-runic-toolkit": "0.1.0-preview.7.1",
    "@vitejs/devtools": "0.4.12",
    "effect": "3.22.1",
    "vite": "8.2.1"
  }
}
