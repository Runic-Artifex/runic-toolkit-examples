<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RunicToolkitDefaultTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../runic-toolkit/src/Runic.Application/Runic.Application.csproj"
                      Condition="Exists('../../../runic-toolkit/src/Runic.Application/Runic.Application.csproj')" />
    <ProjectReference Include="../../../runic-toolkit/src/Runic.Application.Generators/Runic.Application.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="Exists('../../../runic-toolkit/src/Runic.Application.Generators/Runic.Application.Generators.csproj')" />
    <PackageReference Include="Runic.Application"
                      Condition="!Exists('../../../runic-toolkit/src/Runic.Application/Runic.Application.csproj')" />
  </ItemGroup>
</Project>
