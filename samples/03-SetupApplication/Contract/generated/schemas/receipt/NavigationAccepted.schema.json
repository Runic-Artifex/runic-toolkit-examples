{
  "$defs": {
    "Int": {
      "description": "an integer",
      "title": "int",
      "type": "integer"
    },
    "Revision": {
      "description": "a non-negative number",
      "minimum": 0,
      "title": "nonNegative",
      "type": "integer"
    },
    "Uuid": {
      "description": "a string matching the pattern ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "runic.artifex.setup/1/NavigationAccepted",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "_tag": {
      "enum": [
        "NavigationAccepted"
      ],
      "type": "string"
    },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "activeOperationId": {
          "$ref": "#/$defs/Uuid"
        },
        "canNavigateBack": {
          "type": "boolean"
        },
        "canNavigateNext": {
          "type": "boolean"
        },
        "destination": {
          "additionalProperties": false,
          "properties": {
            "availableBytes": {
              "$ref": "#/$defs/Int",
              "description": "a non-negative number",
              "minimum": 0,
              "title": "nonNegative"
            },
            "displayName": {
              "type": "string"
            },
            "selectionId": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "selectionId",
            "displayName",
            "availableBytes"
          ],
          "type": "object"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "selectedFeatures": {
          "items": {
            "enum": [
              "core",
              "desktop-shortcut",
              "examples"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "viewId": {
          "enum": [
            "Welcome",
            "Destination",
            "Features",
            "Installing",
            "Complete"
          ],
          "type": "string"
        }
      },
      "required": [
        "viewId",
        "revision",
        "selectedFeatures",
        "canNavigateBack",
        "canNavigateNext"
      ],
      "type": "object"
    }
  },
  "required": [
    "_tag",
    "snapshot"
  ],
  "type": "object"
}
