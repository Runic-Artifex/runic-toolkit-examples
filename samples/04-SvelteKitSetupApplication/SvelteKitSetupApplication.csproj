<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RunicToolkit.Examples.Setup</RootNamespace>
    <RunicToolkitShippingProject>true</RunicToolkitShippingProject>
    <RunicToolkitGenerateFrontendAssets>true</RunicToolkitGenerateFrontendAssets>
    <RunicToolkitFrontendOutputDirectory>$(MSBuildProjectDirectory)/Frontend/build</RunicToolkitFrontendOutputDirectory>
    <RunicToolkitFrontendEntryPoint>index.html</RunicToolkitFrontendEntryPoint>
    <RunicToolkitFrontendAssetMode>Copy</RunicToolkitFrontendAssetMode>
    <RunicToolkitFrontendBuildCommand>npm install --ignore-scripts &amp;&amp; npm --prefix Frontend run build</RunicToolkitFrontendBuildCommand>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RunicToolkit.ApplicationBridge" />
    <PackageReference Include="RunicToolkit.ApplicationBridge.Generators" PrivateAssets="all" />
    <PackageReference Include="RunicToolkit.Hosting.Build" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi.App" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi.ApplicationBridge" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="../03-SetupApplication/Contract/generated/bridge.manifest.json" />
    <AdditionalFiles Include="../03-SetupApplication/Contract/generated/schemas/**/*.schema.json" />
    <Compile Include="../03-SetupApplication/SetupBridgeHandler.cs" Link="SetupBridgeHandler.cs" />
    <Compile Include="../03-SetupApplication/SetupSmokeTest.cs" Link="SetupSmokeTest.cs" />
  </ItemGroup>
</Project>
