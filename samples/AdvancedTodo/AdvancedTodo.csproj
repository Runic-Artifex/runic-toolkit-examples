<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunicToolkit.Samples.AdvancedTodo</AssemblyName>
    <RootNamespace>RunicToolkit.Samples.AdvancedTodo</RootNamespace>
    <IsPackable>false</IsPackable>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RunicToolkitFrontendNodeEnabled>true</RunicToolkitFrontendNodeEnabled>
    <RunicToolkitFrontendWorkspace>@runic-artifex/sample-todo-cwhtml</RunicToolkitFrontendWorkspace>
    <RunicToolkitFrontendPackageDirectory>$(MSBuildProjectDirectory)/../Todo.Cwhtml.Frontend</RunicToolkitFrontendPackageDirectory>
    <RunicToolkitFrontendOutputDirectory>$(MSBuildProjectDirectory)/../Todo.Cwhtml.Frontend/dist</RunicToolkitFrontendOutputDirectory>
    <RunicToolkitFrontendWorkspaceRoot>$(MSBuildProjectDirectory)/../..</RunicToolkitFrontendWorkspaceRoot>
    <RunicToolkitFrontendWebRoot>wwwroot</RunicToolkitFrontendWebRoot>
    <RunicToolkitFrontendViteDevServerEnabled>true</RunicToolkitFrontendViteDevServerEnabled>
    <RunicToolkitFrontendViteDevServerEntry>/src/main.js</RunicToolkitFrontendViteDevServerEntry>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsWebUi" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="RunicToolkit.Hosting" />
    <PackageReference Include="RunicToolkit.Hosting.Abstractions" />
    <PackageReference Include="RunicToolkit.Hosting.Build" PrivateAssets="all" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi.App" />
    <PackageReference Include="RunicToolkit.Hosting.GenericHost" />
    <PackageReference Include="RunicToolkit.Hosting.WebUi" />
    <PackageReference Include="RunicToolkit.Frontend.Sdk" PrivateAssets="all" />
    <PackageReference Include="RunicToolkit.MVVM.CommunityToolkit" />
    <PackageReference Include="RunicFlow" />
    <PackageReference Include="RunicMarkup.Build" PrivateAssets="all" />
    <PackageReference Include="RunicMarkup.RunicToolkit.CommunityToolkit" PrivateAssets="all" />
    <PackageReference Include="RunicMarkup.RunicToolkit.Htmx" />
    <PackageReference Include="RunicMarkup.RunicToolkit.Htmx.Js" />
    <PackageReference Include="RunicMarkup.RunicToolkit.Htmx.CsWebUi" />
    <PackageReference Include="RunicMarkup.RunicToolkit.Htmx.CsWebUi.App" />
    <PackageReference Include="RunicMarkup.RunicToolkit.FrontendCompiler" PrivateAssets="all" />
    <ProjectReference Include="../Todo.Shared/Todo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <CwhtmlCodeBehind Include="UI/AdvancedTodoRenderModel.cs" />
  </ItemGroup>
</Project>
