@namespace WebUIToolkit.Samples.AdvancedTodo.UI
@view AdvancedTodoAppView(WebUIToolkit.Samples.AdvancedTodo.UI.AdvancedTodoRenderModel model)
div .app-shell
    data-webui-view="advanced-todo"
    data-wut-adapter="community-toolkit" {
    header .hero {
        div .eyebrow {
            i .fa-solid .fa-diagram-project aria-hidden="true" {}
            " ADVANCED SAMPLE · COMPILED HTML + NATIVE HTMX"
        }
        h1 { "Tasks with an architecture" }
        p .lede {
            "Persistent storage, typed commands, searchable projections, cancellable work, and a real Flow workflow in a lightweight native desktop window."
        }
    }

    section .stats aria-label="Task overview" {
        div .stat {
            strong { (model.TotalCount.ToString(System.Globalization.CultureInfo.InvariantCulture)) }
            span { "Total" }
        }
        div .stat {
            strong { (model.RemainingCount.ToString(System.Globalization.CultureInfo.InvariantCulture)) }
            span { "Remaining" }
        }
        div .stat {
            strong { (model.CompletedCount.ToString(System.Globalization.CultureInfo.InvariantCulture)) }
            span { "Completed" }
        }
    }

    main .layout {
        section .board {
            form #filter-form .toolbar
                data-wut-action="filter"
                data-wut-command=(nameof(TodoViewModel.ApplyFilterCommand))
                data-hx-target="#advanced_fragment"
                data-hx-swap="outerHTML" {
                label for="query" { "Search tasks" }
                input #query .form-control
                    type="search"
                    name="query"
                    data-wut-member=(nameof(TodoViewModel.Query))
                    value=(model.Query)
                    maxlength="120"
                    placeholder="Search title or notes…"
                    autocomplete="off";
                label for="filter" { "Filter" }
                select #filter .form-select
                    name="filter"
                    data-wut-member=(nameof(TodoViewModel.Filter))
                    data-wut-validation-message="Choose All, Active, or Completed." {
                    option value="All" selected[=(model.FilterIsAll)] { "All" }
                    option value="Active" selected[=(model.FilterIsActive)] { "Active" }
                    option value="Completed" selected[=(model.FilterIsCompleted)] { "Completed" }
                }
                button .quiet .btn .btn-secondary type="submit" {
                    i .fa-solid .fa-magnifying-glass aria-hidden="true" {}
                    " Apply"
                }
            }

            section .card .add-card {
                div .section-heading {
                    div {
                        h2 { "Quick add" }
                        p { "For routine tasks. Use the planner for the guided path." }
                    }
                }
                form #add-form .add-form
                    data-wut-action="add"
                    data-wut-command=(nameof(TodoViewModel.AddCommand))
                    data-wut-success-event="todo:changed"
                    data-wut-invalid-focus="new-title"
                    data-hx-target="#advanced_fragment"
                    data-hx-swap="outerHTML" {
                    div .field .field-wide {
                        label for="new-title" { "Title" }
                        input #new-title .form-control
                            name="title"
                            data-wut-member=(nameof(TodoViewModel.NewTitle))
                            data-wut-include-validation="true"
                            data-wut-validation-message="Give the task a title between 2 and 120 characters."
                            value=(model.Title)
                            minlength="2"
                            maxlength="120"
                            placeholder="What needs doing?"
                            autocomplete="off"
                            aria-invalid=(model.HasValidationMessage ? "true" : null)
                            aria-describedby=(model.HasValidationMessage ? "quick-title-errors" : null)
                            required[=true];
                        @if (model.HasValidationMessage) {
                            p #quick-title-errors .validation role="alert" {
                                (model.ValidationMessage)
                            }
                        }
                    }
                    div .field {
                        label for="new-notes" { "Notes" }
                        input #new-notes .form-control
                            name="notes"
                            data-wut-member=(nameof(TodoViewModel.NewNotes))
                            value=(model.Notes)
                            maxlength="2000"
                            placeholder="Optional context";
                    }
                    div .field {
                        label for="new-priority" { "Priority" }
                        select #new-priority .form-select
                            name="priority"
                            data-wut-member=(nameof(TodoViewModel.NewPriority))
                            data-wut-validation-message="Choose Low, Normal, or High priority." {
                            option value="Low" selected[=(model.PriorityIsLow)] { "Low" }
                            option value="Normal" selected[=(model.PriorityIsNormal)] { "Normal" }
                            option value="High" selected[=(model.PriorityIsHigh)] { "High" }
                        }
                    }
                    button .primary .btn .btn-success type="submit" {
                        i .fa-solid .fa-plus aria-hidden="true" {}
                        " Add task"
                    }
                }
            }

            section .task-list {
                div .section-heading {
                    div {
                        h2 { "Your tasks" }
                        p {
                            (model.ShownCount.ToString(System.Globalization.CultureInfo.InvariantCulture))
                            " shown"
                        }
                    }
                    form
                        data-wut-action="clear-completed"
                        data-wut-command=(nameof(TodoViewModel.ClearCompletedCommand))
                        data-wut-success-event="todo:changed"
                        data-hx-target="#advanced_fragment"
                        data-hx-swap="outerHTML" {
                        button .quiet .btn .btn-secondary type="submit" {
                            i .fa-solid .fa-broom aria-hidden="true" {}
                            " Clear completed"
                        }
                    }
                }
                div #tasks aria-live="polite" {
                    @if (model.HasItems) {
                        @foreach (WebUIToolkit.Samples.AdvancedTodo.UI.AdvancedTodoRenderItem item in model.Items) {
                            article class=(item.CssClass) {
                                form
                                    data-wut-action="toggle"
                                    data-wut-command=(nameof(TodoViewModel.ToggleCommand))
                                    data-wut-success-event="todo:changed"
                                    data-hx-target="#advanced_fragment"
                                    data-hx-swap="outerHTML" {
                                    button .check
                                        type="submit"
                                        name="selectedId"
                                        data-wut-member=(nameof(TodoViewModel.SelectedId))
                                        data-wut-format="guid"
                                        data-wut-validation-message="That task is no longer available."
                                        value=(item.Id)
                                        aria-label=(item.ToggleLabel) {
                                        i class=(item.ToggleIconClass) aria-hidden="true" {}
                                    }
                                }
                                div .todo-copy {
                                    div .todo-title { (item.Title) }
                                    @if (item.HasNotes) {
                                        p { (item.Notes) }
                                    }
                                    div .meta {
                                        span class=(item.PriorityCssClass) { (item.Priority) }
                                        time { (item.Created) }
                                    }
                                }
                                form
                                    data-wut-action="delete"
                                    data-wut-command=(nameof(TodoViewModel.DeleteCommand))
                                    data-wut-success-event="todo:changed"
                                    data-hx-target="#advanced_fragment"
                                    data-hx-swap="outerHTML" {
                                    button .danger
                                        type="submit"
                                        name="selectedId"
                                        data-wut-member=(nameof(TodoViewModel.SelectedId))
                                        data-wut-format="guid"
                                        data-wut-validation-message="That task is no longer available."
                                        value=(item.Id)
                                        aria-label=(item.DeleteLabel) {
                                        i .fa-solid .fa-trash aria-hidden="true" {}
                                        " Delete"
                                    }
                                }
                            }
                        }
                    }
                    @else {
                        div .empty {
                            span .empty-icon {
                                i .fa-solid .fa-check aria-hidden="true" {}
                            }
                            h3 { "Nothing to show" }
                            p { "Add a task, import the starter set, or try another search and filter." }
                        }
                    }
                }
            }
        }

        aside .side-panel {
            section .card .planner {
                div .section-heading {
                    div {
                        div .eyebrow { "WEBUITOOLKIT.MVVM.FLOW" }
                        h2 { "Guided planner" }
                    }
                }
                div #planner {
                    @if (model.WizardIsClosed) {
                        p {
                            "Create a task through a typed Details → Review workflow with validation and retained Back navigation."
                        }
                        form
                            data-wut-action="wizard-start"
                            data-wut-command=(nameof(TodoViewModel.StartWizardCommand))
                            data-hx-target="#advanced_fragment"
                            data-hx-swap="outerHTML" {
                            button .primary type="submit" { "Open planner" }
                        }
                    }
                    @else {
                        div .steps {
                            span class=(model.WizardIsDetails ? "active" : "done") { "1 Details" }
                            span class=(model.WizardIsReview ? "active" : null) { "2 Review" }
                        }
                        @if (model.WizardIsDetails) {
                            form .stack
                                data-wut-action="wizard-next"
                                data-wut-command=(nameof(TodoViewModel.WizardNextCommand))
                                data-wut-invalid-focus="wizard-title"
                                data-hx-target="#advanced_fragment"
                                data-hx-swap="outerHTML" {
                                label for="wizard-title" { "Title" }
                                input #wizard-title
                                    name="wizardTitle"
                                    data-wut-member=(nameof(TodoViewModel.NewTitle))
                                    data-wut-validation-message="Give the task a title before continuing."
                                    value=(model.Title)
                                    minlength="2"
                                    maxlength="120"
                                    autocomplete="off"
                                    required[=true];
                                label for="wizard-notes" { "Notes" }
                                textarea #wizard-notes name="notes" data-wut-member=(nameof(TodoViewModel.NewNotes)) maxlength="2000" {
                                    (model.Notes)
                                }
                                label for="wizard-priority" { "Priority" }
                                select #wizard-priority
                                    name="priority"
                                    data-wut-member=(nameof(TodoViewModel.NewPriority))
                                    data-wut-validation-message="Choose Low, Normal, or High priority." {
                                    option value="Low" selected[=(model.PriorityIsLow)] { "Low" }
                                    option value="Normal" selected[=(model.PriorityIsNormal)] { "Normal" }
                                    option value="High" selected[=(model.PriorityIsHigh)] { "High" }
                                }
                                @foreach (string issue in model.WizardIssues) {
                                    p .validation role="alert" { (issue) }
                                }
                                button .primary type="submit" { "Continue to review" }
                            }
                            form
                                data-wut-action="wizard-cancel"
                                data-wut-command=(nameof(TodoViewModel.WizardCancelCommand))
                                data-hx-target="#advanced_fragment"
                                data-hx-swap="outerHTML" {
                                button .quiet type="submit" { "Cancel" }
                            }
                        }
                        @if (model.WizardIsReview) {
                            div .review {
                                strong { (model.Title) }
                                p { (model.Notes) }
                                span class=(model.PriorityIsHigh ? "priority high" : (model.PriorityIsLow ? "priority low" : "priority normal")) {
                                    (model.Priority)
                                }
                            }
                            div .button-row {
                                form
                                    data-wut-action="wizard-back"
                                    data-wut-command=(nameof(TodoViewModel.WizardBackCommand))
                                    data-hx-target="#advanced_fragment"
                                    data-hx-swap="outerHTML" {
                                    button .quiet type="submit" { "Back" }
                                }
                                form
                                    data-wut-action="wizard-finish"
                                    data-wut-command=(nameof(TodoViewModel.WizardFinishCommand))
                                    data-wut-success-event="todo:changed"
                                    data-hx-target="#advanced_fragment"
                                    data-hx-swap="outerHTML" {
                                    button .primary type="submit" { "Create task" }
                                }
                            }
                        }
                    }
                }
            }

            section .card .diagnostics {
                div .section-heading {
                    div {
                        div .eyebrow { "DIAGNOSTICS" }
                        h2 { "Activity" }
                    }
                }
                ol #activity .activity aria-live="polite" {
                    @if (model.HasDiagnostics) {
                        @foreach (WebUIToolkit.Samples.AdvancedTodo.UI.AdvancedTodoDiagnostic entry in model.Diagnostics) {
                            li {
                                time { (entry.Time) }
                                span .diagnostic-kind { (entry.Category) }
                                p { (entry.Message) }
                            }
                        }
                    }
                    @else {
                        li { p { "Actions and workflow transitions appear here." } }
                    }
                }
                @if (model.IsImporting) {
                    form #import-status
                        data-wut-action="import-status"
                        data-wut-command=(nameof(TodoViewModel.RefreshImportCommand))
                        data-hx-trigger="load delay:2200ms"
                        data-hx-target="#advanced_fragment"
                        data-hx-swap="outerHTML" {
                    }
                    form #import-cancel
                        data-wut-action="cancel-import"
                        data-wut-command=(nameof(TodoViewModel.CancelImportCommand))
                        data-hx-target="#advanced_fragment"
                        data-hx-swap="outerHTML" {
                        button .quiet .btn .btn-secondary type="submit" {
                            i .fa-solid .fa-ban aria-hidden="true" {}
                            " Cancel running import"
                        }
                    }
                }
                @else {
                    form #import-form
                        data-wut-action="import"
                        data-wut-command=(nameof(TodoViewModel.ImportCommand))
                        data-wut-success-event="todo:changed"
                        data-hx-target="#advanced_fragment"
                        data-hx-swap="outerHTML" {
                        button .secondary .btn .btn-info type="submit" {
                            i .fa-solid .fa-file-import aria-hidden="true" {}
                            " Import starter tasks (2s)"
                        }
                    }
                }
            }
        }
    }
}
