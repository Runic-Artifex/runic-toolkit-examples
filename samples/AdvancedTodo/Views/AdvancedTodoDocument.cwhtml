@namespace WebUIToolkit.Samples.AdvancedTodo.UI
@view AdvancedTodoDocumentView(WebUIToolkit.Samples.AdvancedTodo.UI.AdvancedTodoDocumentModel model)
html lang="en" {
    head {
        meta charset="utf-8";
        meta name="viewport" content="width=device-width, initial-scale=1";
        meta name="color-scheme" content="dark";
        title { "Advanced ToDo · WebUIToolkit" }
        @if (!model.Assets.IsViteDevelopment) {
            link rel="stylesheet" href="cwhtml.css";
        }
    }
    body {
        div #advanced_fragment {
            @render(model.Application);
        }
        script src="webui.js" {}
        @if (model.Assets.IsViteDevelopment) {
            @render(model.Assets);
        } @else {
            script src="cwhtml.js" {}
        }
    }
}
