<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="dependency-notices-local" value=".packages" />
    <add key="aot-support-local" value=".aot-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="dependency-notices-local">
      <package pattern="WebUIToolkit.DependencyNotices.*" />
    </packageSource>
    <packageSource key="aot-support-local">
      <package pattern="Microsoft.*" />
      <package pattern="runtime.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
