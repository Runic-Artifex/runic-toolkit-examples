using System;
using System.Linq;
using WebUIToolkit.CsharpMarkup;
using WebUIToolkit.MVVM.Html.Htmx;
using static WebUIToolkit.Samples.Cwhtml.Components.CsharpMarkupComponents;

namespace WebUIToolkit.Samples.SimpleTodo;

public static partial class TodoCsharpMarkupViews
{
    [HtmlHtmxView(
        "simple-todo",
        "todo_fragment",
        typeof(TodoViewModel),
        typeof(TodoJsonContext))]
    [HtmlHtmxAction(
        "add",
        nameof(TodoViewModel.AddCommand),
        SuccessEvents = "todo:changed",
        InvalidFocus = "new-title")]
    [HtmlHtmxAction(
        "toggle",
        nameof(TodoViewModel.ToggleCommand),
        SuccessEvents = "todo:changed")]
    [HtmlHtmxAction(
        "remove",
        nameof(TodoViewModel.RemoveCommand),
        SuccessEvents = "todo:changed")]
    [HtmlHtmxField(
        "add",
        "title",
        nameof(TodoViewModel.NewTitle),
        Required = true,
        MinimumLength = 2,
        MaximumLength = 80,
        Message = "Give the task a name between 2 and 80 characters.")]
    [HtmlHtmxField(
        "toggle",
        "selectedId",
        nameof(TodoViewModel.SelectedId),
        Format = "guid",
        Message = "That task is no longer available.")]
    [HtmlHtmxField(
        "remove",
        "selectedId",
        nameof(TodoViewModel.SelectedId),
        Format = "guid",
        Message = "That task is no longer available.")]
    [HtmlHtmxCollection(nameof(TodoViewModel.Items))]
    public static HtmlContent TodoApp(
        TodoRenderModel model,
        HtmxRenderContext htmx) =>
        <main
            id="todo-app"
            class="card shadow-lg"
            data-webui-view="simple-todo"
            data-webui-revision={htmx.Revision}>
            <header>
                <p class="eyebrow">
                    <i class="fa-solid fa-laptop-code" aria-hidden="true"></i>
                    WebUIToolkit · beginner sample
                </p>
                <h1>Things worth doing</h1>
                <p class="intro">A tiny C#-authored compiled-HTML desktop MVVM app transported by HTMX.</p>
            </header>

            <form
                id="composer"
                class="composer"
                data-hx-post={htmx.ActionRoute(TodoAppGenerated.HtmxActions.Add)}
                data-hx-target="#todo_fragment"
                data-hx-swap="outerHTML">
                <label class="form-label" for="new-title">What needs doing?</label>
                <div class="composer-row input-group">
                    <input
                        id="new-title"
                        class="form-control"
                        name="title"
                        value={model.Draft}
                        placeholder="e.g. Review the pull request"
                        minlength="2"
                        maxlength="80"
                        autocomplete="off"
                        aria-invalid={model.HasValidationMessage ? "true" : null}
                        aria-describedby={model.HasValidationMessage ? "webui-error-title" : null}
                        required />
                    <button class="btn btn-success" type="submit">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        Add task
                    </button>
                </div>
                {model.HasValidationMessage ? model.Validation : null}
            </form>

            <ul id="tasks" class="tasks list-group list-group-flush" aria-live="polite">
                {model.Items.Select(item =>
                    <li class={item.CssClass}>
                        <form
                            data-hx-post={htmx.ActionRoute(TodoAppGenerated.HtmxActions.Toggle)}
                            data-hx-target="#todo_fragment"
                            data-hx-swap="outerHTML">
                            <button
                                class="toggle btn btn-sm btn-outline-success"
                                type="submit"
                                name="selectedId"
                                value={item.Id}
                                aria-label={item.ToggleLabel}>
                                <i class={item.ToggleIconClass} aria-hidden="true"></i>
                            </button>
                        </form>
                        <span class="task-title">{item.Title}</span>
                        <form
                            data-hx-post={htmx.ActionRoute(TodoAppGenerated.HtmxActions.Remove)}
                            data-hx-target="#todo_fragment"
                            data-hx-swap="outerHTML">
                            <button
                                class="remove btn btn-sm btn-outline-danger"
                                type="submit"
                                name="selectedId"
                                value={item.Id}
                                aria-label={item.RemoveLabel}>
                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                <span class="visually-hidden">Remove</span>
                            </button>
                        </form>
                    </li>)}
            </ul>

            {model.IsEmpty
                ? <p id="empty-state" class="empty-state alert alert-success">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    Nothing left to do. Add a task when inspiration strikes.
                </p>
                : null}
            <StatusBadge Content={model.Status} Active={!model.IsEmpty} />
        </main>;

    [HtmlDocumentView]
    public static HtmlContent TodoDocument(TodoDocumentModel model) =>
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title>Simple Todo · WebUIToolkit</title>
                {!model.Assets.IsViteDevelopment
                    ? <link rel="stylesheet" href="cwhtml.css" />
                    : null}
            </head>
            <body>
                <div id="todo_fragment">{model.Application}</div>
                <footer>
                    State and commands stay in C#. C# markup crosses one native HTMX binding.
                </footer>
                <script src="webui.js"></script>
                {model.Assets.IsViteDevelopment
                    ? model.Assets
                    : <script src="cwhtml.js"></script>}
            </body>
        </html>;
}
