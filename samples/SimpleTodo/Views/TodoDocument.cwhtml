@namespace WebUIToolkit.Samples.SimpleTodo
@view TodoDocumentView(WebUIToolkit.Samples.SimpleTodo.TodoDocumentModel model)
html lang="en" {
    head {
        meta charset="utf-8";
        meta name="viewport" content="width=device-width, initial-scale=1";
        title { "Simple Todo · WebUIToolkit" }
        link rel="stylesheet" href="cwhtml.css";
    }
    body {
        div #todo_fragment {
            @render(model.Application);
        }
        footer {
            "State and commands stay in C#. Compiled HTML crosses one native HTMX binding."
        }
        script src="webui.js" {}
        script src="cwhtml.js" {}
    }
}
