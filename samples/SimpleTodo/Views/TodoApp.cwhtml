@namespace RunicToolkit.Samples.SimpleTodo
@view TodoAppView(RunicToolkit.Samples.SimpleTodo.TodoRenderModel model)
main #todo-app .card .shadow-lg
    data-webui-view="simple-todo"
    data-runic-adapter="community-toolkit"
    data-runic-collection=(nameof(TodoViewModel.Items)) {
    header {
        p .eyebrow {
            i .fa-solid .fa-laptop-code aria-hidden="true" {}
            " Runic Toolkit · beginner sample"
        }
        h1 { "Things worth doing" }
        p .intro { "A tiny compiled-HTML desktop MVVM app transported by HTMX." }
    }

    form #composer .composer
        data-runic-action="add"
        data-runic-command=(nameof(TodoViewModel.AddCommand))
        data-runic-success-event="todo:changed"
        data-runic-invalid-focus="new-title"
        data-hx-target="#todo_fragment"
        data-hx-swap="outerHTML" {
        label .form-label for="new-title" { "What needs doing?" }
        div .composer-row .input-group {
            input #new-title .form-control
                name="title"
                data-runic-member=(nameof(TodoViewModel.NewTitle))
                data-runic-validation-message="Give the task a name between 2 and 80 characters."
                value=(model.Draft)
                placeholder="e.g. Review the pull request"
                minlength="2"
                maxlength="80"
                autocomplete="off"
                aria-invalid=(model.HasValidationMessage ? "true" : null)
                aria-describedby=(model.HasValidationMessage ? "webui-error-title" : null)
                required[=true];
            button .btn .btn-success type="submit" {
                i .fa-solid .fa-plus aria-hidden="true" {}
                " Add task"
            }
        }
        @if (model.HasValidationMessage) {
            @render(model.Validation);
        }
    }

    ul #tasks .tasks .list-group .list-group-flush aria-live="polite" {
        @foreach (RunicToolkit.Samples.SimpleTodo.TodoRenderItem item in model.Items) {
            li class=(item.CssClass) {
                form
                    data-runic-action="toggle"
                    data-runic-command=(nameof(TodoViewModel.ToggleCommand))
                    data-runic-success-event="todo:changed"
                    data-hx-target="#todo_fragment"
                    data-hx-swap="outerHTML" {
                    button .toggle .btn .btn-sm .btn-outline-success
                        type="submit"
                        name="selectedId"
                        data-runic-member=(nameof(TodoViewModel.SelectedId))
                        data-runic-format="guid"
                        data-runic-validation-message="That task is no longer available."
                        value=(item.Id)
                        aria-label=(item.ToggleLabel) {
                        i class=(item.ToggleIconClass) aria-hidden="true" {}
                    }
                }
                span .task-title { (item.Title) }
                form
                    data-runic-action="remove"
                    data-runic-command=(nameof(TodoViewModel.RemoveCommand))
                    data-runic-success-event="todo:changed"
                    data-hx-target="#todo_fragment"
                    data-hx-swap="outerHTML" {
                    button .remove .btn .btn-sm .btn-outline-danger
                        type="submit"
                        name="selectedId"
                        data-runic-member=(nameof(TodoViewModel.SelectedId))
                        data-runic-format="guid"
                        data-runic-validation-message="That task is no longer available."
                        value=(item.Id)
                        aria-label=(item.RemoveLabel) {
                        i .fa-solid .fa-trash aria-hidden="true" {}
                        span .visually-hidden { "Remove" }
                    }
                }
            }
        }
    }

    @if (model.IsEmpty) {
        p #empty-state .empty-state .alert .alert-success {
            i .fa-solid .fa-circle-check aria-hidden="true" {}
            " Nothing left to do. Add a task when inspiration strikes."
        }
    }
    @render(model.Status);
}
