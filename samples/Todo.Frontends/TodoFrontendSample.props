<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RunicToolkitFrontendWorkspace>$(TodoFrontendWorkspace)</RunicToolkitFrontendWorkspace>
    <RunicToolkitFrontendPackageDirectory>$(MSBuildThisFileDirectory)$(TodoFrontendDirectory)</RunicToolkitFrontendPackageDirectory>
    <RunicToolkitFrontendOutputDirectory>$(MSBuildThisFileDirectory)$(TodoFrontendDirectory)/dist</RunicToolkitFrontendOutputDirectory>
    <RunicToolkitFrontendWorkspaceRoot>$(MSBuildThisFileDirectory)../..</RunicToolkitFrontendWorkspaceRoot>
    <RunicToolkitFrontendContractSource>$(MSBuildThisFileDirectory)todo.frontend.json</RunicToolkitFrontendContractSource>
    <RunicToolkitFrontendContractCSharpOutput>$(MSBuildThisFileDirectory)../Todo.FrontendHost/TodoContracts.g.cs</RunicToolkitFrontendContractCSharpOutput>
    <RunicToolkitFrontendContractTypeScriptOutput>$(MSBuildThisFileDirectory)shared/todo-contract.g.ts</RunicToolkitFrontendContractTypeScriptOutput>
    <RunicToolkitFrontendContractReactOutput>$(MSBuildThisFileDirectory)react/src/todo-bindings.g.ts</RunicToolkitFrontendContractReactOutput>
    <RunicToolkitFrontendContractVueOutput>$(MSBuildThisFileDirectory)vue/src/todo-bindings.g.ts</RunicToolkitFrontendContractVueOutput>
    <RunicToolkitFrontendContractSvelteOutput>$(MSBuildThisFileDirectory)svelte/src/todo-bindings.g.ts</RunicToolkitFrontendContractSvelteOutput>
    <RunicToolkitFrontendContractAngularOutput>$(MSBuildThisFileDirectory)angular/src/todo-bindings.g.ts</RunicToolkitFrontendContractAngularOutput>
    <RunicToolkitFrontendDevServerDocument>simple/index.html;advanced/index.html</RunicToolkitFrontendDevServerDocument>
    <RunicToolkitFrontendViteDevServerEnabled
      Condition="'$(TodoFrontendDirectory)' != 'angular'">true</RunicToolkitFrontendViteDevServerEnabled>
    <RunicToolkitFrontendViteDevServerEntry
      Condition="'$(TodoFrontendDirectory)' == 'react'">/src/main.tsx</RunicToolkitFrontendViteDevServerEntry>
    <RunicToolkitFrontendViteDevServerEntry
      Condition="'$(TodoFrontendDirectory)' != 'react' and
                 '$(TodoFrontendDirectory)' != 'angular'">/src/main.ts</RunicToolkitFrontendViteDevServerEntry>
    <RunicToolkitFrontendDevServerKind
      Condition="'$(TodoFrontendDirectory)' == 'angular'">angular</RunicToolkitFrontendDevServerKind>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Todo.FrontendHost/Todo.FrontendHost.csproj" />
    <PackageReference Include="RunicToolkit.Frontend.Sdk" PrivateAssets="all" />
    <Content Include="$(MSBuildThisFileDirectory)../SharedAssets/**/*"
             Link="www/vendor/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
