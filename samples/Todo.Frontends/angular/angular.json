{
  "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "todo-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "todo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "outputPath": {
              "base": ".angular-output",
              "browser": ""
            },
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [
              "bootstrap/dist/css/bootstrap.min.css",
              "@fortawesome/fontawesome-free/css/fontawesome.min.css",
              "@fortawesome/fontawesome-free/css/regular.min.css",
              "@fortawesome/fontawesome-free/css/solid.min.css",
              "../shared/styles.css"
            ],
            "aot": true,
            "optimization": false,
            "outputHashing": "none",
            "sourceMap": true
          },
          "configurations": {
            "production": {
              "aot": true,
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "outputHashing": "all",
              "sourceMap": true
            },
            "development": {
              "aot": true,
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true
            },
            "mock": {
              "browser": "src/main.mock.ts",
              "aot": true,
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
          },
          "configurations": {
            "development": {
              "buildTarget": "todo-angular:build:development"
            },
            "mock": {
              "buildTarget": "todo-angular:build:mock"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
