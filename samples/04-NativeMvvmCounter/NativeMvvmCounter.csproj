<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunicToolkit.Samples.NativeMvvmCounter</AssemblyName>
    <RootNamespace>RunicToolkit.Samples.NativeMvvmCounter</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsWebUi" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="RunicAssets" />
    <PackageReference Include="RunicAssets.RunicToolkit" />
    <PackageReference Include="RunicToolkit.Hosting" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi" />
    <PackageReference Include="RunicToolkit.Hosting.CsWebUi.Mvvm" />
    <PackageReference Include="RunicToolkit.Hosting.GenericHost" />
    <PackageReference Include="RunicToolkit.Hosting.WebUi" />
    <PackageReference Include="RunicToolkit.MVVM.CommunityToolkit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="www/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../SharedAssets/**/*"
             Link="www/vendor/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'runictoolkit.hosting.cswebui.mvvm/0.1.0-preview.4.1/contentFiles/any/any/wwwroot/runic-toolkit-mvvm-cswebui.mjs'))"
             Link="www/vendor/runic-toolkit-mvvm-cswebui.mjs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../node_modules/@runic-artifex/mvvm/dist/esm/**/*"
             Link="www/vendor/mvvm/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
