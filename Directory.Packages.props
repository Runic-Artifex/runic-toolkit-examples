<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package versions are added here only after their owning ADR/evaluation gate. -->
    <PackageVersion Include="Runic.Translations" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.Translations.Build" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.CommandLine" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.CommandLine.Processes" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.Assets" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.Assets.AspNetCore" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.Assets.Desktop" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.Application" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.Application.Bridge" Version="1.0.0-preview.1" />
    <PackageVersion Include="Runic.Application.Desktop" Version="1.0.0-preview.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
  </ItemGroup>
</Project>
